# ─────────────────────────────────────────────────────────────
# .env.example — Sao chép file này thành .env và điền giá trị thật
# File .env KHÔNG được commit lên Git
# ─────────────────────────────────────────────────────────────

# ── SQL Server ─────────────────────────────────────────────────
# Phải đủ mạnh: chữ hoa + chữ thường + số + ký tự đặc biệt, tối thiểu 8 ký tự
SA_PASSWORD=YourStrongP@ssw0rd!

# ── JWT ────────────────────────────────────────────────────────
JWT_KEY=PlanifySecretKey2024_SuperSecure_AtLeast32Characters!
JWT_ISSUER=PlanifyAPI
JWT_AUDIENCE=PlanifyClient
JWT_EXPIRE_MINUTES=1440

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Email (Gmail SMTP) ─────────────────────────────────────────
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
